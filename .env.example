# Production URL used for canonical links, Open Graph, sitemap, and robots.txt.
# Falls back to https://bernardabuto.vercel.app when unset.
NEXT_PUBLIC_SITE_URL=https://bernardabuto.vercel.app

# Contact form (required for the form to send). Create a key at https://resend.com.
RESEND_API_KEY=
# Optional. Where messages are delivered; defaults to the address in src/content/site.ts.
CONTACT_TO_EMAIL=
# Optional. Sender address; must be on a domain verified in Resend.
# Defaults to Resend's test sender, which can only deliver to your own Resend account email.
CONTACT_FROM_EMAIL=
